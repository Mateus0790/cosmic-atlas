# Cosmic Atlas - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
VITE_APP_TITLE=Cosmic Atlas
VITE_APP_DESCRIPTION=Open-source interactive 3D atlas of the known universe

# API Configuration (optional - for production deployments)
# VITE_API_BASE_URL=https://api.cosmic-atlas.dev

# Data Sources - API Keys (optional, for higher rate limits)
# CelesTrak - no key required for basic access
# Space-Track - requires free registration
# VITE_SPACE_TRACK_USERNAME=your_username
# VITE_SPACE_TRACK_PASSWORD=your_password

# JPL Horizons - no key required
# NASA APIs - optional key for higher rate limits
# VITE_NASA_API_KEY=your_nasa_api_key

# ESA Gaia Archive - no key required for basic access
# SIMBAD - no key required

# Analytics (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
# VITE_ENABLE_SATELLITES=true
# VITE_ENABLE_PROBES=true
# VITE_ENABLE_GAIA=true
# VITE_ENABLE_EXTRAGALACTIC=true

# Performance
# VITE_MAX_STARS=100000
# VITE_MAX_SATELLITES=5000
# VITE_LOD_ENABLED=true

# Debug
# VITE_DEBUG_ORBITS=false
# VITE_DEBUG_COORDINATES=false
# VITE_DEBUG_PERFORMANCE=false